# Copy to .env (never commit it). Only ACCESS_TOKEN is strongly recommended; the rest unlock extra data.
PORT=3000
# Shared secret your friends put in the connector URL: https://your-host/mcp/<ACCESS_TOKEN>
ACCESS_TOKEN=
# https://foreverdb.net/developers (log in with Battle.net, request access)
FOREVERDB_API_KEY=
# https://develop.battle.net/access/clients (free)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Optional
# EVERLOOT_URL=https://everloot.app/mcp/public
# EVERLOOT_HOURLY_BUDGET=180
