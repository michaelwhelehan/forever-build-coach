{
  "name": "forever-build-coach",
  "version": "0.3.0",
  "description": "MCP server on Cloudflare Workers that helps optimise WoW: Forever character builds while levelling",
  "scripts": {
    "kb:bundle": "node scripts/bundle-kb.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "npm run kb:bundle && tsc --noEmit",
    "test": "npm run kb:bundle && vitest run",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run --outdir dist"
  },
  "license": "MIT",
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  },
  "type": "module"
}
